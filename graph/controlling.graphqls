"""
What a programme's instances cost the faculty in a semester.

The controlling view the faculty plans its electives against. **Whoever holds the teaching pays
for it:** the hours count at the programme of the instance that holds the parts. A module has one
home in the catalogue — Analysis is IF's and appears in DC's regulations as well — but DC's own
Analysis is DC's to pay for, and a cohort that joins another programme's event instead holds no
parts and costs nothing; the host pays. The spreadsheet before this tool expressed this with an IF
and a DC variant of the module.

The split by the home programme of the modules is kept beside the total: how much of what a
programme pays for is other programmes' modules is the import figure.

# Which hours

Teaching hours: the sum over the parts of every instance, by the rule `CourseInstance.teachingHours`
states. A four-hour module with a lecture and three laboratory groups costs eight; a lecture held
once for two cohorts counts once; a cohort covered by another programme's event costs nothing; a
part another faculty teaches is not ours and is reported as `externalHours` instead.
Not `Module.contactHoursPerWeek`, which is what a student attends and is not a teaching load.
"""
type ProgrammeTeachingLoad {
  "The programme whose instances hold the teaching, and which pays for it."
  programme: Programme!
  "The whole load of the programme's instances in this semester."
  teachingHours: Float!
  "The part of it spent on the programme's own modules. The rest is other programmes' modules."
  ownHours: Float!
  "The number of the programme's instances, covered ones included."
  instanceCount: Int!
  """
  How many of them are elective placeholders. "We need three FWP" is three cohorts of one, so
  this is the number a programme lead plans against.
  """
  fwpInstanceCount: Int!
  "The teaching those placeholders cost."
  fwpHours: Float!
  """
  Parts that state no hours and therefore count zero. Anything above zero means `teachingHours`
  is too low, not that the semester is light.
  """
  partsWithoutHours: Int!
  """
  What other faculties teach in the programme's instances — parts with `InstancePart.taughtBy`.
  **Not** in `teachingHours` or any other figure here, because it is not this faculty's teaching;
  reported beside it for the dean's office, who asks how much of what our students attend
  somebody else gives.
  """
  externalHours: Float!
  """
  The load split by the home programme of the modules, ordered by its code. Empty for a planned
  programme nothing has been declared for yet.
  """
  shares: [TeachingLoadShare!]!
  """
  What the programme may spend in the study year this semester belongs to, as the dean's office
  entered it — see `ProgrammeQuota`. `null` when nothing has been entered, which is not zero.
  """
  yearlyQuota: Float
  """
  What this semester may spend of `yearlyQuota`. A winter: half of it, because its summer is
  still to come. A summer: what the winter of the same study year left — `yearlyQuota` minus that
  winter's `teachingHours` — because what the winter spent is spent. `null` without a quota.
  """
  semesterQuota: Float
  """
  `semesterQuota` minus `teachingHours`. Negative: the programme spends more than it has.
  Positive: there is room, for another elective or for a programme that needs more than its own.
  For a summer this is what is left of the study year. `null` without a quota.
  """
  balance: Float
}

"""
One programme's study year: the quota, what its winter costs and what its summer costs.

The view a programme lead plans against: is there room for another elective this year. The
summer counts as soon as its demand is declared, which is how a summer is played through while
the winter is still being planned.
"""
type ProgrammeStudyYearLoad {
  "The programme that pays, as `ProgrammeTeachingLoad.programme`."
  programme: Programme!
  "The year the study year's winter semester starts in."
  studyYear: Int!
  "The quota entered for the study year, or `null` when nothing has been entered."
  yearlyQuota: Float
  "The teaching of the programme's instances in the winter semester, as `teachingLoad` counts it."
  winterHours: Float!
  "The same for the summer semester that follows."
  summerHours: Float!
  "`yearlyQuota` minus both semesters. Negative: the year is overspent. `null` without a quota."
  remaining: Float
  "Parts in either semester that state no hours and therefore count zero."
  partsWithoutHours: Int!
}

"""
What a study programme may spend on teaching in one study year.

The figure comes from the faculty's capacity calculation — the teaching available to a programme,
theses included — and is entered by the dean's office. Counted the way `teachingHours` counts:
every laboratory and exercise group.

A study year is named after the year its winter semester starts in: `2026` is `2026-WS` and
`2027-SS`. Each of the two semesters is read against half of it.
"""
type ProgrammeQuota {
  "The programme the figure is for."
  programme: Programme!
  "The year the study year's winter semester starts in: `2026` for 2026-WS and 2027-SS."
  studyYear: Int!
  "Teaching hours per week over the study year."
  teachingHours: Float!
  "When it was last set."
  setAt: Time!
}

"The part of a programme's load spent on the modules of one home programme."
type TeachingLoadShare {
  "The home programme of the modules."
  homeProgramme: Programme!
  "The teaching of those modules in the programme's instances."
  teachingHours: Float!
  "How many of the programme's instances are of those modules."
  instanceCount: Int!
  "How many of them are elective placeholders."
  fwpInstanceCount: Int!
  "The teaching those placeholders cost."
  fwpHours: Float!
  "Parts among them that state no hours and therefore count zero."
  partsWithoutHours: Int!
  "What other faculties teach in those instances, beside `teachingHours` rather than in it."
  externalHours: Float!
}

extend type Query {
  """
  The teaching a semester's demand costs, by the programme whose instances hold it.

  Every programme the faculty plans is listed, at zero if nothing has been declared for it — that
  is the row somebody is looking for — and any other programme only when its instances hold
  teaching here. Readable by everybody who may read the demand, through a token too: it is a sum
  over rows that are not confidential.
  """
  teachingLoad(
    "Four digits, a hyphen and SS or WS, for example `2027-SS`."
    semester: String!
  ): [ProgrammeTeachingLoad!]! @scope(area: PLANNING, verb: READ)

  """
  A study year's teaching by paying programme: winter and summer beside the year's quota. Every
  programme that appears in either semester is listed, by code. Readable like `teachingLoad`.
  """
  studyYearLoad(
    "The year the study year's winter semester starts in: `2026` for 2026-WS and 2027-SS."
    studyYear: Int!
  ): [ProgrammeStudyYearLoad!]! @scope(area: PLANNING, verb: READ)

  """
  The quotas entered for one study year, ordered by programme code. A programme without one is
  not listed.
  """
  programmeQuotas(
    "The year the study year's winter semester starts in: `2026` for 2026-WS and 2027-SS."
    studyYear: Int!
  ): [ProgrammeQuota!]! @scope(area: PLANNING, verb: READ)
}

extend type Mutation {
  """
  Enter or correct what a study programme may spend in a study year, or take it back with
  `teachingHours: null`. Returns the quota as it now stands, `null` once taken back.

  The dean's office, which runs the capacity calculation, and through both doors: it is a number
  corrected as often as the calculation is. Not the programme leads — the quota is the line a
  programme is measured against.
  """
  setProgrammeQuota(
    "The programme's short code. Upper-cased and trimmed for you."
    programme: String!
    "The year the study year's winter semester starts in."
    studyYear: Int!
    "Teaching hours per week over the year, between 0 and 10000. `null` takes the quota back."
    teachingHours: Float
  ): ProgrammeQuota @scope(area: PLANNING, verb: WRITE)
}
